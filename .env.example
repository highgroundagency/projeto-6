# Prumo — variáveis de ambiente
# Copie para .env.local. Nada aqui é obrigatório para rodar em desenvolvimento.

# ---------------------------------------------------------------------------
# Conteúdo
# ---------------------------------------------------------------------------

# Pasta do projeto no Google Drive. Sem valor, o link não é exibido para o
# visitante e o painel avisa que falta configurar.
NEXT_PUBLIC_DRIVE_URL=

# Repositório usado como evidência de código nos registros semanais.
NEXT_PUBLIC_REPO_URL=

# ---------------------------------------------------------------------------
# Painel administrativo
# ---------------------------------------------------------------------------

# Senha do painel. Vazia = 0321, que está no briefing E neste repositório público.
# TROQUE em produção: é ela que impede um visitante de mexer no release e de avançar o
# estado do ciclo no /sistema. Nenhum link do site leva ao painel, mas isso não protege
# nada por si só — o endereço é /admin/entrar. Ver ADR-015 em docs/decisoes.md.
ADMIN_SENHA=

# Assinatura do cookie de sessão. Mínimo de 16 caracteres.
# Em produção é OBRIGATÓRIA: sem ela o painel fica indisponível, de propósito.
ADMIN_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Release (§6)
# ---------------------------------------------------------------------------
# Em produção, antes da F3, estas variáveis são a única forma de mudar o que o
# PÚBLICO vê — o filesystem da Vercel é read-only. Ver docs/releases.md.

# Quantos dias à frente o site mostra. Padrão: 7.
RELEASE_ADIANTAMENTO_DIAS=

# Fixa o release num ciclo específico (ex.: sr1). Vazio = automático pela data.
RELEASE_OVERRIDE=

# Travas por ciclo, em JSON. Ex.: {"s9":"sempre_visivel","s2":"sempre_oculto"}
RELEASE_TRAVAS=

# Caminho do arquivo de configuração em desenvolvimento.
CONFIG_SITE_ARQUIVO=

# Force o store somente leitura localmente, para reproduzir o comportamento de
# produção (filesystem read-only).
CONFIG_SITE_SOMENTE_LEITURA=

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# O app NÃO usa banco: os dados são sintéticos e vivem em memória.
#
# As duas variáveis abaixo servem só ao schema guardado em supabase/migrations/,
# que está escrito e testado mas desligado da aplicação. Ver docs/banco.md.

# Alvo de `npm run semear` — qualquer PostgreSQL com as migrações aplicadas.
DATABASE_URL=

# Banco descartável usado por `npm run testar-rls`. Sem ela, os testes de
# política são pulados e o resto da suíte continua rodando.
DATABASE_URL_TESTE=
