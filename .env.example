# Prumo — variáveis de ambiente
# Copie para .env.local. Nada aqui é obrigatório para rodar em desenvolvimento.

# ---------------------------------------------------------------------------
# Conteúdo
# ---------------------------------------------------------------------------

# Pasta do projeto no Google Drive. Sem valor, o link não é exibido para o
# visitante e o painel avisa que falta configurar.
NEXT_PUBLIC_DRIVE_URL=

# Repositório usado como evidência de código nos registros semanais.
NEXT_PUBLIC_REPO_URL=

# Endereço público do site, mostrado no slide de fechamento do pitch (/pitch).
# Vazio = https://projeto6-si.vercel.app, o deploy da Vercel a partir de main.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Painel administrativo
# ---------------------------------------------------------------------------

# Chave AES-256 do cookie de login do /sistema: 32 bytes em base64.
# Gere com: openssl rand -base64 32
# Vazia em desenvolvimento = chave fixa de desenvolvimento (com aviso).
# Em PRODUÇÃO é obrigatória: sem ela, o login fica indisponível de propósito.
SESSAO_CHAVE=

# Senha do painel. Vazia = 0321, que está no briefing E neste repositório público.
# TROQUE em produção: é ela que impede um visitante de mexer no release e de avançar o
# estado do ciclo no /sistema. Nenhum link do site leva ao painel, mas isso não protege
# nada por si só — o endereço é /admin/entrar. Ver ADR-015 em docs/decisoes.md.
ADMIN_SENHA=

# Assinatura do cookie de sessão. Mínimo de 16 caracteres.
# Em produção é OBRIGATÓRIA: sem ela o painel fica indisponível, de propósito.
ADMIN_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Release (§6)
# ---------------------------------------------------------------------------
# Em produção, antes da F3, estas variáveis são a única forma de mudar o que o
# PÚBLICO vê — o filesystem da Vercel é read-only. Ver docs/releases.md.

# Quantos dias à frente o site mostra. Padrão: 7.
RELEASE_ADIANTAMENTO_DIAS=

# Fixa o release num ciclo específico (ex.: sr1). Vazio = automático pela data.
RELEASE_OVERRIDE=

# Travas por ciclo, em JSON. Ex.: {"s9":"sempre_visivel","s2":"sempre_oculto"}
RELEASE_TRAVAS=

# Caminho do arquivo de configuração em desenvolvimento.
CONFIG_SITE_ARQUIVO=

# Force o store somente leitura localmente, para reproduzir o comportamento de
# produção (filesystem read-only).
CONFIG_SITE_SOMENTE_LEITURA=

# Chave do link da vitrine pessoal. Com ela configurada, visitar
# /vitrine/<chave> grava um cookie assinado e ESTE navegador passa a ver o site
# inteiro com a data simulada da vitrine (2027, semestre encerrado), sem senha e
# sem painel. Sair: /vitrine/sair. Mínimo de 16 caracteres; use um valor longo e
# aleatório, porque a chave É o link. Vazia = a rota não existe (404).
# NUNCA versione o valor: o repositório é público. Ver ADR-030.
CHAVE_VITRINE=

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# O /sistema lê e grava no PostgreSQL. Ver docs/banco.md.
#
#   docker compose up -d && npm run db:preparar
#
# O valor abaixo é o do Postgres do docker-compose.yml, só para desenvolvimento.
# Em produção, a URL do Postgres hospedado vai nas variáveis da Vercel.
DATABASE_URL=postgresql://prumo:prumo@localhost:5432/prumo

# PRODUÇÃO NA AWS: em vez de DATABASE_URL, o NOME do segredo no Secrets
# Manager. Usuário e senha ficam só lá; quem roda precisa de um papel IAM com
# `secretsmanager:GetSecretValue` nesse segredo. Ver docs/banco.md.
# DATABASE_SECRET_ID=prumo/producao/banco
# AWS_REGION=sa-east-1
# Por quanto tempo a senha lida fica em cache (rotação). Padrão: 300.
# DATABASE_SECRET_TTL_SEGUNDOS=300
# TLS: "exigir" (padrão com Secrets Manager) ou "desligado" (padrão local).
# DATABASE_SSL=exigir
# Certificado do RDS: baixe https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DATABASE_SSL_CA=/caminho/global-bundle.pem

# Só para quem precisar rodar sem Docker: `seed` volta aos dados em memória,
# que somem a cada reinício. Vazio = PostgreSQL.
DADOS_DRIVER=

# Bancos DESCARTÁVEIS: os testes apagam o conteúdo deles a cada execução.
# Nunca aponte para o banco de cima. Crie com:
#   docker compose exec postgres createdb -U prumo prumo_teste
#   docker compose exec postgres createdb -U prumo prumo_e2e
# DATABASE_URL_TESTE: `npm test` (driver, RLS e semeadura). Vazia = testes de banco pulados.
# DATABASE_URL_E2E: `npm run e2e`, obrigatória para a suíte de ponta a ponta.
DATABASE_URL_TESTE=
DATABASE_URL_E2E=

# Vitrine com prazo: enquanto o relógio não passar deste instante, TODO visitante
# vê os 18 ciclos e as oito telas do sistema. Depois, o recorte volta sozinho.
# Formato ISO 8601, ex.: 2026-08-17T06:00:00Z. Vazio ou malformado = fechada.
# Isto suspende a garantia do §6.3 de propósito — ver ADR-021.
RELEASE_ABERTO_ATE=

# Data que o site finge que é, enquanto a vitrine estiver aberta. Formato
# YYYY-MM-DD. Sem ela, a vitrine libera tudo mas o calendário continua real — e
# o topo segue dizendo "próximo marco: Kick-off". Com ela, o site inteiro se
# comporta como se fosse aquele dia: marcos concluídos, nenhuma semana corrente.
# Só tem efeito com RELEASE_ABERTO_ATE válido: quando o prazo vence, a data
# volta junto com a visibilidade.
RELEASE_DATA_SIMULADA=
